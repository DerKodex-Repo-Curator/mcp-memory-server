# Server Configuration
PORT=8090
OLLAMA_URL=http://localhost:11434
MCP_URL=http://localhost:3000

# Memory Configuration
MAX_CONTEXT_TOKENS=2000
SIMILARITY_LIMIT=10
RELEVANCE_THRESHOLD=0.3
AUTO_ENRICH=true

# Brain Integration
BRAIN_ENABLED=true
BRAIN_DATA_DIR=~/.brain

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Logging
LOG_LEVEL=info
