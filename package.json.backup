{
  "name": "mcp-memory-server",
  "version": "0.1.0",
  "description": "MCP Middleware Server for Ollama with intelligent memory and context enrichment",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "memory-cli": "./memory-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "cli": "node memory-cli.js"
  },
  "keywords": [
    "mcp",
    "ollama",
    "memory",
    "middleware",
    "ai"
  ],
  "author": "MikeyBeez & Claude",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "node-cache": "^5.1.2",
    "p-queue": "^7.4.1",
    "zod": "^3.22.4",
    "cli-table3": "^0.6.3",
    "commander": "^11.0.0",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
